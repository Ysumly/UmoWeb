<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ysumly.umowebbackend.mapper.ContentTagMapper">

    <insert id="insert">
        INSERT INTO content_tag (content_id, tag_id)
        VALUES (#{contentId}, #{tagId})
    </insert>

    <insert id="insertIgnore">
        INSERT IGNORE INTO content_tag (content_id, tag_id)
        VALUES (#{contentId}, #{tagId})
    </insert>

    <delete id="deleteLinks">
        DELETE FROM content_tag
        WHERE content_id IN
        <foreach collection="contentIds" item="contentId"
                 open="(" separator="," close=")">
            #{contentId}
        </foreach>
          AND tag_id IN
        <foreach collection="tagIds" item="tagId"
                 open="(" separator="," close=")">
            #{tagId}
        </foreach>
    </delete>

    <delete id="deleteByContentId">
        DELETE FROM content_tag WHERE content_id = #{contentId}
    </delete>

    <select id="findTagIdsByContentId" resultType="long">
        SELECT tag_id FROM content_tag WHERE content_id = #{contentId}
    </select>

    <select id="findLinksByContentIds" resultType="ContentTagLink">
        SELECT content_id, tag_id
        FROM content_tag
        WHERE content_id IN
        <foreach collection="contentIds" item="contentId" open="(" separator="," close=")">
            #{contentId}
        </foreach>
        ORDER BY content_id, tag_id
    </select>

    <select id="countContentsByTagId" resultType="long">
        SELECT COUNT(*)
        FROM content_tag
        WHERE tag_id = #{tagId}
    </select>

</mapper>
